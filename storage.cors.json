[
  {
    "origin": ["*"],
    "method": ["GET", "HEAD", "PUT", "POST", "DELETE", "OPTIONS"],
    "responseHeader": [
      "Content-Type",
      "Authorization",
      "Content-Length",
      "Content-Range",
      "x-goog-resumable",
      "x-firebase-gmpid",
      "x-goog-upload-protocol",
      "x-goog-upload-command",
      "x-goog-upload-offset",
      "x-goog-upload-status",
      "Access-Control-Allow-Origin"
    ],
    "maxAgeSeconds": 3600
  }
]
