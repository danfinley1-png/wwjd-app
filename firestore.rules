rules_version = '2';

// WWJD-DI — minimal Firestore rules (default deny).
// Public: published saints, share links, TTS config.
// Signed-in: own users/{uid}/…, aggregate usage counters.
// Admin claim: saint writes, draft saint reads, usage reports.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    // Same check as PlatformAdminClaim: token.admin, or the foundation email
    // on the ID token (the client does not require email_verified).
    function isFoundationAdmin() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'dan.finley@verizon.net';
    }

    function isVerifiedPlatformAdmin() {
      return isAdmin()
        || isFoundationAdmin()
        || (
          signedIn()
          && exists(/databases/$(database)/documents/platformAdmins/$(request.auth.uid))
          && get(/databases/$(database)/documents/platformAdmins/$(request.auth.uid)).data.get('role', '') == 'superAdmin'
        );
    }

    function hasOrgMembership(orgId) {
      return signedIn()
        && exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid));
    }

    function orgMemberRole(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.get('role', '');
    }

    function isOrgCreator(orgId) {
      return signedIn()
        && exists(/databases/$(database)/documents/organizations/$(orgId))
        && get(/databases/$(database)/documents/organizations/$(orgId)).data.get('createdByUid', '') == request.auth.uid;
    }

    // Org-scoped admin: role on the membership doc, or the org creator.
    function isOrgAdmin(orgId) {
      return isOrgCreator(orgId)
        || (hasOrgMembership(orgId) && orgMemberRole(orgId) == 'orgAdmin');
    }

    function isGroupLeader(orgId) {
      return hasOrgMembership(orgId) && orgMemberRole(orgId) == 'groupLeader';
    }

    // Single-group get for a member. Not a list: groupId must be on their membership.
    function isGroupMember(orgId, groupId) {
      return hasOrgMembership(orgId)
        && get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.get('groupIds', []).hasAny([groupId]);
    }

    function canManageGroupGifts(orgId, groupId) {
      return isVerifiedPlatformAdmin()
        || isOrgAdmin(orgId)
        || (isGroupLeader(orgId) && isGroupMember(orgId, groupId));
    }

    function isValidGroupGiftDef(orgId, groupId) {
      let d = request.resource.data;
      return d.organizationId == orgId
        && d.groupId == groupId
        && d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.description is string && d.description.size() > 0 && d.description.size() <= 4000
        && d.frequency in ['Daily', 'Weekly', 'Monthly', 'One-time']
        && d.active is bool
        && d.createdByUid is string && d.createdByUid.size() > 0 && d.createdByUid.size() <= 128
        && d.createdAt is timestamp
        && (!('linkedPrayerId' in d) || (d.linkedPrayerId is string && d.linkedPrayerId.size() <= 128))
        && (!('specificTime' in d) || (d.specificTime is string && d.specificTime.size() <= 16))
        && (!('logoUrl' in d) || (d.logoUrl is string && d.logoUrl.size() <= 2000))
        && (!('groupName' in d) || (d.groupName is string && d.groupName.size() <= 200))
        && (!('organizationName' in d) || (d.organizationName is string && d.organizationName.size() <= 300))
        && (!('daysOfWeek' in d) || d.daysOfWeek is list)
        && (!('sharedFromGiftId' in d) || (d.sharedFromGiftId is string && d.sharedFromGiftId.size() <= 128))
        && (!('sharedFromGroupId' in d) || (d.sharedFromGroupId is string && d.sharedFromGroupId.size() <= 128))
        && (!('sortOrder' in d) || (d.sortOrder is int && d.sortOrder >= 0 && d.sortOrder <= 500))
        && (!('updatedAt' in d) || d.updatedAt is timestamp);
    }

    function isValidGroupGiftCopy() {
      let d = request.resource.data;
      return d.source == 'groupGift'
        && d.organizationId is string && d.organizationId.size() > 0 && d.organizationId.size() <= 128
        && d.groupId is string && d.groupId.size() > 0 && d.groupId.size() <= 128
        && d.userId is string && d.userId.size() > 0 && d.userId.size() <= 128
        && d.title is string && d.title.size() > 0 && d.title.size() <= 200;
    }

    function memberHasGroup(orgId, memberId, groupId) {
      return exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(memberId))
        && get(/databases/$(database)/documents/organizations/$(orgId)/members/$(memberId)).data.get('groupIds', []).hasAny([groupId]);
    }

    function canManageOrgGroups(orgId) {
      return isVerifiedPlatformAdmin()
        || isOrgAdmin(orgId)
        || isGroupLeader(orgId);
    }

    // Org invite delivery. Overall admin and org admin may invite any role.
    // A group leader may invite members and group leaders only.
    function canDeliverOrgInvite(orgId) {
      return isVerifiedPlatformAdmin()
        || isOrgAdmin(orgId)
        || (
          isGroupLeader(orgId)
          && request.resource.data.role in ['member', 'groupLeader']
        );
    }

    function isValidOrgInvite(orgId) {
      let d = request.resource.data;
      return d.organizationId == orgId
        && d.email is string
        && d.email.size() > 3
        && d.email.size() <= 320
        && d.role in ['member', 'groupLeader', 'orgAdmin']
        && d.status in ['pending', 'accepted', 'revoked']
        && d.groupIds is list
        && d.groupIds.size() <= 40
        && d.createdAt is timestamp
        && (!('invitedByUid' in d) || (d.invitedByUid is string && d.invitedByUid.size() <= 128))
        && (!('organizationName' in d) || (d.organizationName is string && d.organizationName.size() <= 300))
        && (!('emailSubject' in d) || (d.emailSubject is string && d.emailSubject.size() <= 300))
        && (!('emailText' in d) || (d.emailText is string && d.emailText.size() <= 20000))
        && (!('acceptedAt' in d) || d.acceptedAt is timestamp)
        && (!('acceptedByUid' in d) || (d.acceptedByUid is string && d.acceptedByUid.size() <= 128));
    }

    function inviteEmailMatchesAuth() {
      return signedIn()
        && request.auth.token.email is string
        && resource.data.email is string
        && resource.data.email.lower() == request.auth.token.email.lower();
    }

    function isValidOrgInviteeResponse() {
      return inviteEmailMatchesAuth()
        && resource.data.status == 'pending'
        && request.resource.data.status in ['accepted', 'revoked']
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'acceptedAt', 'acceptedByUid']);
    }

    function hasPendingOrgJoin(orgId) {
      return signedIn()
        && request.auth.token.email is string
        && exists(/databases/$(database)/documents/pendingOrgJoinsByEmail/$(request.auth.token.email.lower())/orgs/$(orgId));
    }

    function isValidMember(orgId) {
      let d = request.resource.data;
      return d.organizationId == orgId
        && d.role in ['member', 'groupLeader', 'orgAdmin']
        && d.groupIds is list
        && d.groupIds.size() <= 40
        && d.joinedAt is timestamp
        && (!('email' in d) || (d.email is string && d.email.size() <= 320))
        && (!('displayName' in d) || (d.displayName is string && d.displayName.size() <= 200))
        && (!('invitedByUid' in d) || (d.invitedByUid is string && d.invitedByUid.size() <= 128));
    }

    function isValidGroupInviteCreate(orgId) {
      let d = request.resource.data;
      return d.organizationId == orgId
        && d.groupId is string && d.groupId.size() > 0 && d.groupId.size() <= 128
        && d.groupName is string && d.groupName.size() > 0 && d.groupName.size() <= 200
        && d.inviteeUid is string && d.inviteeUid.size() > 0 && d.inviteeUid.size() <= 128
        && d.inviteeEmail is string && d.inviteeEmail.size() <= 320
        && d.invitedByUid == request.auth.uid
        && d.status == 'pending'
        && d.createdAt is timestamp
        && (!('organizationName' in d) || (d.organizationName is string && d.organizationName.size() <= 300))
        && (!('emailSubject' in d) || (d.emailSubject is string && d.emailSubject.size() <= 300))
        && (!('emailText' in d) || (d.emailText is string && d.emailText.size() <= 20000));
    }

    function isGroupPracticeDelivery(userId) {
      let d = request.resource.data;
      return d.source == 'groupSchedule'
        && d.organizationId is string
        && d.organizationId.size() > 0
        && d.organizationId.size() <= 128
        && d.groupId is string
        && d.groupId.size() > 0
        && d.groupId.size() <= 128
        && d.groupScheduleId is string
        && d.groupScheduleId.size() > 0
        && d.groupScheduleId.size() <= 128
        && d.title is string
        && d.title.size() > 0
        && d.title.size() <= 500
        && memberHasGroup(d.organizationId, userId, d.groupId)
        && (
          isVerifiedPlatformAdmin()
          || isOrgAdmin(d.organizationId)
          || canManageOrgGroups(d.organizationId)
        );
    }

    function canDeliverGroupGiftCopy(userId) {
      let d = request.resource.data;
      return isValidGroupGiftCopy()
        && d.userId == userId
        && canManageGroupGifts(d.organizationId, d.groupId)
        && memberHasGroup(d.organizationId, userId, d.groupId);
    }

    function isPublishedSaint() {
      return resource.data.get('published', false) == true
        || resource.data.get('status', '') == 'published';
    }

    match /saints/{slug} {
      allow read: if isPublishedSaint() || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /users/{uid} {
      allow read, write: if isUser(uid);

      // Ask WWJD counters — Cloud Functions only (Admin SDK).
      match /chatQuota/{document=**} {
        allow read: if isUser(uid);
        allow write: if false;
      }

      // Member copies of a group Gift. The owner already writes their own gifts.
      // A group manager may write only a groupGift copy for an accepted member.
      match /gifts/{giftId} {
        allow create, update: if canDeliverGroupGiftCopy(uid);
        allow update, delete: if resource.data.get('source', '') == 'groupGift'
          && canManageGroupGifts(
            resource.data.organizationId,
            resource.data.groupId
          );
      }

      // Membership indexes only. Not chat, reflections, history, or personal gifts.
      match /orgMemberships/{membershipOrgId} {
        allow create, update: if (isVerifiedPlatformAdmin() || isOrgAdmin(membershipOrgId))
          && request.resource.data.organizationId == membershipOrgId
          && request.resource.data.role in ['member', 'groupLeader', 'orgAdmin']
          && request.resource.data.joinedAt is timestamp;
        allow delete: if isVerifiedPlatformAdmin() || isOrgAdmin(membershipOrgId);
      }

      match /groupMemberships/{groupId} {
        allow create, update: if request.resource.data.organizationId is string
          && request.resource.data.groupId == groupId
          && request.resource.data.keys().hasAll(['organizationId', 'groupId'])
          && (isVerifiedPlatformAdmin() || isOrgAdmin(request.resource.data.organizationId));
        allow delete: if resource.data.organizationId is string
          && (isVerifiedPlatformAdmin() || isOrgAdmin(resource.data.organizationId));
      }

      // Group schedule copies. The owner reads their own. A group manager may
      // write only a groupSchedule copy for someone already in that group.
      match /groupPractices/{practiceId} {
        allow create: if isGroupPracticeDelivery(uid);
        allow update: if resource.data.get('source', '') == 'groupSchedule'
          && request.resource.data.organizationId == resource.data.organizationId
          && request.resource.data.groupId == resource.data.groupId
          && memberHasGroup(
            resource.data.organizationId,
            uid,
            resource.data.groupId
          )
          && (
            isVerifiedPlatformAdmin()
            || isOrgAdmin(resource.data.organizationId)
            || canManageOrgGroups(resource.data.organizationId)
          );
      }

      match /pendingGroupInvites/{inviteId} {
        allow create: if request.resource.data.status == 'pending'
          && request.resource.data.organizationId is string
          && request.resource.data.groupId is string
          && request.resource.data.createdAt is timestamp
          && canManageOrgGroups(request.resource.data.organizationId);
      }

      match /{subcollection}/{document=**} {
        allow read, write: if isUser(uid) && subcollection != 'chatQuota';
      }
    }

    match /shares/{shareId} {
      allow read: if true;
      allow create: if signedIn();
      allow update, delete: if signedIn()
        && request.auth.uid == resource.data.get('createdByUid', '');
    }

    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /platformUsage/daily/days/{dayId} {
      allow read: if isAdmin();
      allow create, update: if signedIn();
    }

    match /platformUsage/meta/docs/{docId} {
      allow read: if isAdmin();
      allow create, update: if signedIn() && docId == 'tracking';
    }

    // List queries (orderBy) need allow read, not allow get.
    // Platform admin: every org, group, member list, and group gift.
    // Org admin / group leader: only that organization.
    // Accepted member: get their group, and read gifts for a group in groupIds.
    match /organizations/{orgId} {
      allow read: if isVerifiedPlatformAdmin();
      allow get: if isOrgAdmin(orgId) || isGroupLeader(orgId) || hasOrgMembership(orgId);

      match /groups/{groupId} {
        allow read: if isVerifiedPlatformAdmin() || isOrgAdmin(orgId) || isGroupLeader(orgId);
        allow get: if isGroupMember(orgId, groupId);

        match /gifts/{giftId} {
          allow read: if isVerifiedPlatformAdmin()
            || isOrgAdmin(orgId)
            || isGroupMember(orgId, groupId);
          allow create: if canManageGroupGifts(orgId, groupId)
            && isValidGroupGiftDef(orgId, groupId)
            && request.resource.data.createdByUid == request.auth.uid;
          allow update: if canManageGroupGifts(orgId, groupId)
            && isValidGroupGiftDef(orgId, groupId)
            && request.resource.data.createdByUid == resource.data.createdByUid
            && request.resource.data.organizationId == resource.data.organizationId
            && request.resource.data.groupId == resource.data.groupId;
          allow delete: if canManageGroupGifts(orgId, groupId);
        }

        match /schedules/{scheduleId} {
          allow read: if isVerifiedPlatformAdmin()
            || isOrgAdmin(orgId)
            || isGroupMember(orgId, groupId);
        }
      }

      match /members/{memberId} {
        allow read: if isVerifiedPlatformAdmin() || isOrgAdmin(orgId) || isGroupLeader(orgId);
        allow get: if signedIn() && request.auth.uid == memberId;
        allow create: if isValidMember(orgId)
          && (
            isVerifiedPlatformAdmin()
            || isOrgAdmin(orgId)
            || (isUser(memberId) && hasPendingOrgJoin(orgId))
          );
        allow update: if isValidMember(orgId)
          && (
            isVerifiedPlatformAdmin()
            || isOrgAdmin(orgId)
            || (
              isUser(memberId)
              && request.resource.data.role == resource.data.role
              && request.resource.data.organizationId == resource.data.organizationId
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['groupIds'])
            )
          );
      }

      match /invites/{inviteId} {
        allow read: if isVerifiedPlatformAdmin() || isOrgAdmin(orgId) || isGroupLeader(orgId);
        allow get: if inviteEmailMatchesAuth();
        allow create, update: if canDeliverOrgInvite(orgId) && isValidOrgInvite(orgId);
        allow update: if isValidOrgInviteeResponse() && isValidOrgInvite(orgId);
      }

      match /groupInvites/{inviteId} {
        allow read: if isVerifiedPlatformAdmin() || isOrgAdmin(orgId) || isGroupLeader(orgId);
        allow get: if signedIn() && (
          resource.data.inviteeUid == request.auth.uid
          || (
            request.auth.token.email is string
            && resource.data.inviteeEmail is string
            && resource.data.inviteeEmail.lower() == request.auth.token.email.lower()
          )
        );
        allow create: if canManageOrgGroups(orgId) && isValidGroupInviteCreate(orgId);
        allow update: if signedIn()
          && resource.data.status == 'pending'
          && request.resource.data.status in ['accepted', 'rejected']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt'])
          && (
            resource.data.inviteeUid == request.auth.uid
            || (
              request.auth.token.email is string
              && resource.data.inviteeEmail is string
              && resource.data.inviteeEmail.lower() == request.auth.token.email.lower()
            )
          );
      }
    }

    match /emailInvites/{emailKey}/items/{inviteId} {
      allow read: if signedIn()
        && request.auth.token.email is string
        && request.auth.token.email.lower() == emailKey;
      allow create, update: if request.resource.data.email is string
        && request.resource.data.email.lower() == emailKey
        && request.resource.data.organizationId is string
        && canDeliverOrgInvite(request.resource.data.organizationId)
        && isValidOrgInvite(request.resource.data.organizationId);
      allow update: if isValidOrgInviteeResponse()
        && isValidOrgInvite(resource.data.organizationId);
      allow delete: if resource.data.organizationId is string
        && (isVerifiedPlatformAdmin() || isOrgAdmin(resource.data.organizationId));
    }

    match /pendingOrgJoinsByEmail/{emailKey}/orgs/{orgId} {
      allow read: if signedIn()
        && request.auth.token.email is string
        && request.auth.token.email.lower() == emailKey;
      allow create, update: if request.resource.data.email is string
        && request.resource.data.email.lower() == emailKey
        && canDeliverOrgInvite(orgId)
        && isValidOrgInvite(orgId);
      allow delete: if signedIn() && (
        (request.auth.token.email is string && request.auth.token.email.lower() == emailKey)
        || isVerifiedPlatformAdmin()
        || isOrgAdmin(orgId)
      );
    }
  }
}
