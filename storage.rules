rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function validSaintUpload() {
      return request.resource.size < 80 * 1024 * 1024
        && (
          request.resource.contentType == 'video/mp4'
          || request.resource.contentType == 'image/jpeg'
        );
    }

    match /Saints/{saintId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && validSaintUpload();
      allow delete: if isAdmin();
    }
  }
}
